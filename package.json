{
  "name": "clod-code",
  "version": "1.3.0",
  "description": "Agent chat workspace with an integrated agent browser",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "npm run check && node tools/context-budget.test.js && node tools/desktop-tools.test.js",
    "check": "node --check main.js && node --check preload.js && node --check desktop-container.js && node --check app/app.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.clodcode.app",
    "productName": "Clod Code",
    "files": [
      "main.js",
      "preload.js",
      "desktop-container.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
